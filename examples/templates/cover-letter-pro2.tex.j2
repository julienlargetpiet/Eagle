\par
((* endfor *))

\vspace{0.35cm}

% Closing
((* if closing *))
((( closing )))
((* else *))
Sincerely,
((* endif *))

\vspace{0.3cm}

{\sffamily\bfseries\color{primary}((( name )))\par}

\end{document}
