% Professional blue palette
\definecolor{primary}{HTML}{17365D}
\definecolor{accent}{HTML}{3676B5}
\definecolor{softblue}{HTML}{EAF2FA}
\definecolor{secondary}{HTML}{526579}
\definecolor{bodytext}{HTML}{26313D}
\definecolor{separator}{HTML}{CBD9E8}

% Document settings
\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.65em}
\setstretch{1.12}

% Header separator with a blue accent segment
\newcommand{\headerrule}{%
  \noindent
  {\color{accent}\rule{2.8cm}{2.2pt}}%
  {\color{separator}\rule{\dimexpr\linewidth-2.8cm\relax}{2.2pt}}\par
}

% Light blue subject panel with a solid accent on the left
\newsavebox{\subjectpanel}
\newcommand{\subjectbox}[1]{%
  \par\noindent\begingroup
  \setlength{\fboxsep}{10pt}%
  \sbox{\subjectpanel}{%
    \colorbox{softblue}{%
      \parbox{\dimexpr\linewidth-3pt-2\fboxsep\relax}{%
        \sffamily\bfseries\large\color{primary}#1}}}%
  {\color{accent}\rule[-\dp\subjectpanel]{3pt}%
    {\dimexpr\ht\subjectpanel+\dp\subjectpanel\relax}}%
  \usebox{\subjectpanel}\par
  \endgroup
}

\begin{document}

\color{bodytext}

% Candidate information
{\sffamily\bfseries\fontsize{27}{31}\selectfont
\color{primary}((( name )))\par}

\vspace{0.12cm}

\begingroup
\small\sffamily\color{secondary}
\setlength{\parskip}{2pt}

((* if email *))
\href{mailto:((( email )))}{\textcolor{accent}{((( email )))}}\par
((* endif *))

((* if phone *))
((( phone )))\par
((* endif *))

((* if city *))
((( city )))\par
((* endif *))

\endgroup

\vspace{0.25cm}
\headerrule
\vspace{0.35cm}

% Recipient
