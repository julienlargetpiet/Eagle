% Compact, understated section headings
\titleformat{\section}[block]
  {\large\bfseries\color{primary}}{}{0pt}{}
  [\vspace{2pt}{\color{separator}\titlerule[0.8pt]}]
\titlespacing*{\section}{0pt}{15pt}{7pt}

% Entry heading with wrapping text and right-aligned dates
\newcommand{\cventry}[3]{%
  \par\addvspace{5pt}\noindent
  \Needspace{3\baselineskip}%
  \begingroup\setlength{\parskip}{0pt}%
  \begin{tabularx}{\linewidth}{@{}>{\raggedright\arraybackslash}X@{\hspace{1em}}>{\raggedleft\arraybackslash}p{0.25\linewidth}@{}}
    \textbf{\relax #1} --- #2 & \leavevmode{\small\textcolor{secondary}{\relax #3}}
  \end{tabularx}\endgroup\par\nopagebreak[3]%
}

% Two-tone separator, matching the cover letter
\newcommand{\headerrule}{%
  \noindent
  {\color{accent}\rule{2.8cm}{2.2pt}}%
  {\color{separator}\rule{\dimexpr\linewidth-2.8cm\relax}{2.2pt}}\par
}

% Pale blue headline panel, matching the cover letter's subject panel
\newsavebox{\headlinepanel}
\newcommand{\headlinebox}[1]{%
  \par\noindent\begingroup
  \setlength{\fboxsep}{7pt}%
  \sbox{\headlinepanel}{%
    \colorbox{softblue}{%
      \parbox{\dimexpr\linewidth-3pt-2\fboxsep\relax}{%
        \centering\large\color{primary}#1}}}%
  {\color{accent}\rule[-\dp\headlinepanel]{3pt}%
    {\dimexpr\ht\headlinepanel+\dp\headlinepanel\relax}}%
  \usebox{\headlinepanel}\par
  \endgroup
}

